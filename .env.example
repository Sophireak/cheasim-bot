# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Sheet Name or ID
# Default sheet title is 'School_Uniform_Inventory'
GOOGLE_SHEET_NAME=School_Uniform_Inventory

# Option A (Local / VPS): Path to the Google Service Account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Option B (Cloud Deployment like Railway / Render):
# Paste the entire contents of credentials.json as a single string
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}

# Store Owner Telegram Handle (without @, e.g. bNha_dev)
STORE_CONTACT_USERNAME=bNha_dev

# School Store Office Phone Number
STORE_PHONE_NUMBER=+855 99 382 751

# Admin Telegram User IDs allowed to manage stock (comma-separated list of numeric IDs)
ADMIN_USER_IDS=1125935802

# Background Sync Interval in seconds (default: 60)
CACHE_SYNC_INTERVAL=60
